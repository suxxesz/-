DATABASE_URL=postgres://city:city_local@localhost:5432/city
PORT=3001
HOST=127.0.0.1
POSTGRES_PASSWORD=city_local
BOT_TOKEN=
MINI_APP_URL=https://your-public-app.example
# Server-only random secret, at least 32 characters. Never use VITE_ for secrets.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Telegram numeric user IDs, comma separated. Admin access must be explicitly configured.
ADMIN_TELEGRAM_IDS=
# Frontend: demo (default, browser-local) or server (Telegram authentication + PostgreSQL).
VITE_DATA_MODE=demo
# Leave empty when API and frontend share an origin.
VITE_API_URL=
# Ключ для приёма отключений от организаций: POST /api/integrations/outages, заголовок x-api-key.
INTEGRATION_API_KEY=
# Папка для фото и видео жалоб (в Docker подключить volume).
UPLOAD_DIR=uploads

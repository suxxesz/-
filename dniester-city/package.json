{
  "name": "moy-gorod",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "server": "tsx server/index.ts",
    "bot": "tsx server/bot.ts",
    "db:setup": "tsx server/setup.ts",
    "test": "tsx --test tests/*.test.ts",
    "provision": "tsx server/provision.ts",
    "test:e2e": "playwright test",
    "build:server": "node scripts/build-server.mjs",
    "server:prod": "node build/server/index.mjs",
    "format": "prettier --write src server tests e2e scripts *.ts *.json *.md"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "framer-motion": "14.11.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.62.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

{
  "name": "moy-gorod",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "prisma generate && tsc --noEmit && vite build && node scripts/build-server.mjs",
    "server": "tsx server/index.ts",
    "bot": "tsx server/bot.ts",
    "db:setup": "tsx server/setup.ts",
    "test": "tsx --test tests/*.test.ts",
    "provision": "tsx server/provision.ts",
    "test:e2e": "playwright test",
    "build:server": "node scripts/build-server.mjs",
    "server:prod": "node build/server/index.mjs",
    "format": "prettier --write src server tests e2e scripts *.ts *.json *.md",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:baseline": "prisma migrate resolve --applied 0_init",
    "db:studio": "prisma studio",
    "pretest": "prisma generate",
    "start": "prisma migrate deploy && node build/server/index.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.10",
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "framer-motion": "14.11.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.62.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "telegraf": "4.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "pglite-prisma-adapter": "0.7.2",
    "prettier": "3.9.10",
    "sass": "1.108.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
